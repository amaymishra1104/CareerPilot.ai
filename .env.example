# ==============================================================================
# OSVI.ai GTM Automation Platform — Environment Variables
# Note: The platform runs completely in Demo Mode if none of these are set!
# ==============================================================================

# 1. Supabase PostgreSQL Persistence (Optional — defaults to local JSON persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. LLM Provider (Optional — defaults to deterministic factual synthesizer)
# Supported: openai, anthropic, gemini, mock_demo
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# 3. Company & Lead Search Provider (Optional — defaults to curated US QSR Demo dataset)
# Supported: apollo, perplexity, hunter, mock_demo
SEARCH_PROVIDER=mock_demo
SEARCH_API_KEY=
SEARCH_API_ENDPOINT=https://api.perplexity.ai/chat/completions

# 4. Gmail API OAuth Integration (Optional — defaults to Internal Draft Queue)
# Scope needed: https://www.googleapis.com/auth/gmail.compose
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/auth/gmail/callback
GMAIL_REFRESH_TOKEN=
GMAIL_USER_EMAIL=

# 5. n8n Automation Webhook
N8N_WEBHOOK_SECRET=osvi_secret_token_123

# 6. Next.js Runtime
NODE_ENV=development
PORT=3000
